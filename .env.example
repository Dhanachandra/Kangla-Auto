# ---------------------------------------------------------------
# Kangla Auto — configuration (copy to .env and adjust)
# ---------------------------------------------------------------

APP_ENV=development                    # development | staging | production
LOG_LEVEL=INFO

# HMAC key for JWT signing. REQUIRED in production and must be >= 32 chars.
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite (quickstart) or PostgreSQL (production / Docker).
# Local:    sqlite:///./data/app.db
# Postgres: postgresql+psycopg://kangla:PASSWORD@localhost:5432/kangla
DATABASE_URL=sqlite:///./data/app.db

# Dev convenience: creates tables from models at startup. Set false in prod
# where `alembic upgrade head` manages schema.
AUTO_CREATE_TABLES=true

# Seed demo riders/drivers on startup (safe to leave on in dev).
SEED_ON_STARTUP=true

# Comma-separated list of allowed browser origins (CORS).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173